/* 字体 */
.page.data-v-9d4f95ad {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部 */
.banner.data-v-9d4f95ad {
  padding: 40rpx 44rpx 8rpx;
}
.banner-head.data-v-9d4f95ad {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左右两个大字 */
.banner-char.data-v-9d4f95ad {
  font-size: 78rpx;
  font-weight: 700;
  line-height: 1;
  color: #191919;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 中间标语 */
.banner-center.data-v-9d4f95ad {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 18rpx;
}
.center-rule.data-v-9d4f95ad {
  width: 40rpx;
  height: 2rpx;
  background: rgba(0, 0, 0, 0.15);
}
.banner-sub.data-v-9d4f95ad {
  margin: 0 14rpx;
  font-size: 26rpx;
  color: #7F7F7F;
  letter-spacing: 4rpx;
  white-space: nowrap;
}
.banner-rule.data-v-9d4f95ad {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.rule-line.data-v-9d4f95ad {
  flex: 1;
  height: 2rpx;
  background: rgba(0, 0, 0, 0.18);
}
.rule-dot.data-v-9d4f95ad {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07C160;
  margin: 0 12rpx;
}
.feed.data-v-9d4f95ad {
  padding: 20rpx 24rpx 0;
}
.feed-foot.data-v-9d4f95ad {
  padding: 30rpx 0 20rpx;
  text-align: center;
}
.foot-tip.data-v-9d4f95ad {
  font-size: 24rpx;
  color: #7F7F7F;
  letter-spacing: 4rpx;
}
.foot-more.data-v-9d4f95ad {
  color: #05A652;
}

/* 空态 */
.empty.data-v-9d4f95ad {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-char.data-v-9d4f95ad {
  width: 110rpx;
  height: 110rpx;
  border: 3rpx solid #7F7F7F;
  border-radius: 12rpx;
  color: #7F7F7F;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}
.empty-text.data-v-9d4f95ad {
  margin-top: 30rpx;
  color: #7F7F7F;
  font-size: 26rpx;
}

/* 悬浮按钮 */
.fab.data-v-9d4f95ad {
  position: fixed;
  right: 44rpx;
  bottom: 180rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #3AD27F, #07C160);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.45);
  z-index: 100;
  transition: transform 0.15s ease;
}
.fab.data-v-9d4f95ad:active {
  transform: scale(0.92);
}
.fab-plus.data-v-9d4f95ad {
  color: #FFFFFF;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
}
.tab-placeholder.data-v-9d4f95ad {
  height: 40rpx;
}