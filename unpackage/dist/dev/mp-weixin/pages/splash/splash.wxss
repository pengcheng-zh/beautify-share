.splash.data-v-b5d3b004 {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(160deg, #f4eedf 0%, #ece2cb 55%, #e4d6b8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 水墨圆环水印 */
.splash.data-v-b5d3b004::before {
  content: "";
  position: absolute;
  width: 900rpx;
  height: 900rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(7, 193, 96, 0.1);
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  box-shadow: inset 0 0 0 60rpx rgba(7, 193, 96, 0.02), inset 0 0 0 120rpx rgba(7, 193, 96, 0.02), inset 0 0 0 180rpx rgba(7, 193, 96, 0.02);
}
.frame.data-v-b5d3b004 {
  position: relative;
  width: 80%;
  height: 82%;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 0 44rpx;
  box-sizing: border-box;
}
.corner.data-v-b5d3b004 {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-color: #07C160;
}
.corner-tl.data-v-b5d3b004 {
  top: -4rpx;
  left: -4rpx;
  border-top: 4rpx solid;
  border-left: 4rpx solid;
}
.corner-tr.data-v-b5d3b004 {
  top: -4rpx;
  right: -4rpx;
  border-top: 4rpx solid;
  border-right: 4rpx solid;
}
.corner-bl.data-v-b5d3b004 {
  bottom: -4rpx;
  left: -4rpx;
  border-bottom: 4rpx solid;
  border-left: 4rpx solid;
}
.corner-br.data-v-b5d3b004 {
  bottom: -4rpx;
  right: -4rpx;
  border-bottom: 4rpx solid;
  border-right: 4rpx solid;
}
.brand-name.data-v-b5d3b004 {
  position: absolute;
  bottom: 44rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 10rpx;
  color: #191919;
  text-indent: 10rpx;
  animation: fadeUp-b5d3b004 1s 0.4s ease both;
}

/* 竖排逐字 */
.verse.data-v-b5d3b004 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
}
.char.data-v-b5d3b004 {
  font-size: 60rpx;
  line-height: 1.4;
  color: #191919;
  font-weight: 600;
  opacity: 0;
  transform: translateY(26rpx);
  animation: charIn-b5d3b004 0.7s ease forwards;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.4);
}
@keyframes charIn-b5d3b004 {
from {
    opacity: 0;
    transform: translateY(26rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
@keyframes fadeUp-b5d3b004 {
from {
    opacity: 0;
    transform: translateY(18rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}