/* 字体 */
.page.data-v-0ee0ae21 {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.section.data-v-0ee0ae21 {
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
}
.label.data-v-0ee0ae21 {
  font-size: 28rpx;
  font-weight: 600;
  color: #191919;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

/* 头像 */
.avatar-row.data-v-0ee0ae21 {
  display: flex;
  align-items: center;
}
.avatar.data-v-0ee0ae21 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: inset 0 -8rpx 16rpx rgba(0, 0, 0, 0.12);
}
.avatar-img.data-v-0ee0ae21 {
  width: 100%;
  height: 100%;
}
.avatar-text.data-v-0ee0ae21 {
  color: #FFFFFF;
  font-size: 60rpx;
  font-weight: 600;
}
.avatar-side.data-v-0ee0ae21 {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}
.avatar-tip.data-v-0ee0ae21 {
  font-size: 28rpx;
  color: #191919;
}
.avatar-clear.data-v-0ee0ae21 {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #07C160;
}

/* 输入 */
.input.data-v-0ee0ae21 {
  background: #f7f3ea;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #191919;
}
.ta.data-v-0ee0ae21 {
  width: 100%;
  height: 120rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #191919;
  box-sizing: border-box;
}
.ph.data-v-0ee0ae21 {
  color: #B2B2B2;
}
.count.data-v-0ee0ae21 {
  text-align: right;
  font-size: 22rpx;
  color: #7F7F7F;
}

/* 定位 */
.loc-row.data-v-0ee0ae21 {
  display: flex;
  align-items: center;
  background: #f7f3ea;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.pin.data-v-0ee0ae21 {
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #05A652;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-right: 16rpx;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}
.loc-text.data-v-0ee0ae21 {
  flex: 1;
  font-size: 28rpx;
  color: #191919;
}
.loc-arrow.data-v-0ee0ae21 {
  color: #7F7F7F;
  font-size: 36rpx;
}
.loc-clear.data-v-0ee0ae21 {
  margin-top: 16rpx;
  text-align: right;
  font-size: 24rpx;
  color: #7F7F7F;
}

/* 保存 */
.save-row.data-v-0ee0ae21 {
  margin-top: 40rpx;
}
.save.data-v-0ee0ae21 {
  background: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
}