/* 字体 */
page {
  background-color: #FFFFFF;
  color: #191919;
  font-size: 28rpx;
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

/* 通用工具类 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 印章风格的小标题 */
.seal-title {
  display: inline-flex;
  align-items: center;
  color: #191919;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.seal-title::before {
  content: "";
  width: 10rpx;
  height: 32rpx;
  background: #07C160;
  margin-right: 14rpx;
  border-radius: 4rpx;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 14px;
  border: 1rpx solid #EBEBEB;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
